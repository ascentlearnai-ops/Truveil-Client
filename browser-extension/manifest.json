{
  "manifest_version": 3,
  "name": "Truveil Interview Window Sharing",
  "version": "0.1.0",
  "description": "Explicitly share hostname-only tab activity from one candidate-selected interview window.",
  "minimum_chrome_version": "116",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["tabs"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Truveil interview window sharing" },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:*; base-uri 'none'; frame-ancestors 'none'"
  }
}
